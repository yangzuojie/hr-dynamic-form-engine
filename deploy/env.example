# 生产环境变量：复制到服务器 /etc/hr-form/env（权限 600），不要提交真实值。
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://hr_form:CHANGE_ME@127.0.0.1:5432/hr_form
DB_POOL_MAX=5
# 用 openssl rand -hex 32 生成
JWT_SECRET=CHANGE_ME
FILE_SIGNING_SECRET=CHANGE_ME
UPLOAD_DIR=/var/lib/hr-form/uploads
FONT_PATH=/opt/hr-form/assets/fonts/NotoSansSC-Regular.otf
MIGRATIONS_DIR=/opt/hr-form/migrations
# 可选：真实的钉钉机器人地址；不配置时钉钉插件只模拟发送
DINGTALK_WEBHOOK=
# 演示账号密码（seed 时使用）
SEED_PASSWORD=CHANGE_ME
