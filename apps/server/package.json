{
  "name": "@hr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:db": "tsx scripts/dev-db.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "fetch-font": "tsx scripts/fetch-font.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@hr/schema-core": "workspace:^",
    "@pdf-lib/fontkit": "^1.1.1",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
